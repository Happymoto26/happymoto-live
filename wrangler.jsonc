{
  "name": "happymoto-live",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TourRoom"
      }
    ]
  },
  "exports": {
    "Chat": {
      "type": "durable-object",
      "state": "deleted"
    },
    "TourRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
